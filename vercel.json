{
  "rewrites": [
    { "source": "/((?!sitemap.xml|robots.txt|favicon.svg|favicon-32x32.png|apple-touch-icon.png|og-image.jpg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}